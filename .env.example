# TravelAgent 环境变量模板
#
# 使用方法：
#   1. 复制本文件为 .env
#   2. 填入你的真实 API Key 和 Host
#   3. 在代码中通过 os.environ.get() 读取（config/settings.py 已配置）
#
# 注意：.env 文件不应提交到 Git（已在 .gitignore 中忽略）
#
# 部署环境（VPS）的 .env 由 GitHub Actions 自动生成（见 .github/workflows/deploy.yml）：
#   只需在仓库 Settings→Secrets and variables→Actions 配置 DEEPSEEK_API_KEY
#   （必填）与 QWEATHER_API_KEY 等（可选），每次部署自动写入 /opt/travelagent/.env，
#   无需手动 SSH 登录服务器改配置。

# --- 和风天气 API ---
# 获取方式：https://console.qweather.com/setting
# 1. 注册账号 → 创建项目 → 添加 API KEY 凭据
# 2. API Host 在 控制台-设置 中查看，形如 abc1234xyz.def.qweatherapi.com
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# --- 高德地图 API（后续接入 MapTool/TrafficTool 时使用）---
# 获取方式：https://lbs.amap.com/dev/
AMAP_API_KEY=

# --- RollingGo 酒店 MCP（hotel_tool live 模式）---
ROLLINGGO_MCP_URL=https://mcp.rollinggo.cn/mcp
ROLLINGGO_API_KEY=
ROLLINGGO_MCP_TIMEOUT=30
ROLLINGGO_MCP_MAX_RETRIES=2
ROLLINGGO_MCP_RETRY_BACKOFF_BASE=1.0

# --- 运行模式 ---
# 设为 false 关闭 Demo 模式，使用真实 API（需配合上面的 API Key）
# 设为 true（默认）使用 Mock 数据，不调真实 API
# 注：网页抓取（web_fetch/web_search）与 12306 火车票查询（train_ticket 等 4 个工具）
#     无需 API Key，只要 DEMO_MODE=false 即走真实接口
DEMO_MODE=true

# A 侧真实数据总开关（USE_LIVE_DATA=1 时规划层走工具真源：景点/交通矩阵/酒店/餐厅；
# 任一环节失败自动回退假数据）。默认跟随 DEMO_MODE（DEMO_MODE=false 即开启），
# 可用 "1"/"true"/"yes" 显式开启
# USE_LIVE_DATA=1

# E5：预约/动作持久化文件（空 = 关闭；生产建议 logs/actions.json，
# 进程重启后恢复未决动作；本地 Demo/测试默认关闭即可）
# BOOKING_PERSIST_PATH=logs/actions.json

# --- A 侧 LLM（AB 合码方案 §三.9，合码后必需；a_side/call_llm/config.py 读取）---
# LLM_PROVIDER: glm / deepseek（默认 deepseek）。key 只进服务器 .env，绝不提交 git。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 若改用 GLM（如 GLM-5.2），把 LLM_PROVIDER 改为 glm 并填下面三项：
# GLM_API_KEY=
# GLM_BASE_URL=https://llmapi.paratera.com/v1/
# GLM_MODEL=GLM-5.2
